cc_library_shared {
    name: "gatekeeper.tegra",
    vendor: true,
    relative_install_path: "hw",
    
    srcs: [
        "module.cpp",
        "SoftGateKeeperDevice.cpp",
    ],
    
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wunused",
        "-Wno-missing-field-initializers",
        "-fvisibility=hidden",
        "-DANDROID_API_LEVEL=S",
    ],
    
    shared_libs: [
        "libbinder",
        "libhardware",
        "libhardware_legacy",
        "liblog",
        "libbase",
        "libutils",
        "libcutils",
        "libcrypto",
        "libhidlbase",
        "libfmq",
        "libgatekeeper",
        "android.hardware.gatekeeper@1.0",
        "libselinux",
    ],
    
    static_libs: [
        "libscrypt_static",
        "libhidlmemory",
    ],
    
    header_libs: [
        "libhardware_headers",
        "libutils_headers",
        "libbase_headers",
    ],
    
    include_dirs: [
        "external/scrypt/lib/crypto",
        "system/core/libutils/include",
        "system/core/libcutils/include",
        "hardware/libhardware/include",
        "system/libhidl/transport/include",
    ],
}
